# --- Telegram ---
# Получить на https://my.telegram.org → API development tools
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_PHONE=+79991234567

# 2FA-пароль, если включён. Оставь пустым, если не нужен.
TG_2FA_PASSWORD=

# --- MAX ---
# Получить у @MasterBot в MAX.
MAX_TOKEN=

# --- VK (когда дойдём до VK-адаптера) ---
# VK_TOKEN=

# --- Общее ---
# Путь к SQLite. По умолчанию ./data/bridge.db
BRIDGE_DB=./data/bridge.db

# Уровень логов (debug | info | warn | error)
LOG_LEVEL=info